# Aegis-Kid OS Backend - COPY to .env and fill in. NEVER commit a real .env.
# No real keys, phone numbers, or tokens are stored in this repo.

# --- App ---
APP_NAME=Aegis-Kid OS Backend
DEBUG=false
ALLOWED_ORIGINS=https://parent.aegis-kid.example,https://support.aegis-kid.example
DATABASE_PATH=./data/aegis.db
# Heartbeat gap (minutes) after which a dead-man check fires. Default 30.
HEARTBEAT_TIMEOUT_MINUTES=30

# --- Ed25519 server signing key (base64, 32-byte seed) ---
# Generate one with: python -c "import nacl.signing, base64; print(base64.b64encode(bytes(nacl.signing.SigningKey.generate())) .decode())"
# Leave blank in dev: an ephemeral key is generated at startup and a
# warning is logged. Tokens signed by an ephemeral key do NOT survive restart.
ED25519_PRIVATE_KEY_B64=
ED25519_PUBLIC_KEY_B64=

# --- DigiLocker (parent identity / adulthood verification) ---
DIGILOCKER_BASE_URL=https://api.digilocker.gov.in
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=https://parent.aegis-kid.example/digilocker/callback
# MVP ONLY: true returns a stubbed verified-adult result without calling
# DigiLocker. Must be false in any real deployment.
DIGILOCKER_MOCK_MODE=true

# --- Cloud AI Safety Adjudicator (pluggable LLM hook) ---
# Only resource metadata (URL/package + age_tier) is ever sent to the LLM.
# No child PII, browsing history, or free text is sent. Leave blank to use
# the deterministic rule engine only.
LLM_API_KEY=
LLM_BASE_URL=https://api.example-llm-provider.example/v1
LLM_MODEL=

# --- WhatsApp Business API (parent breach alerts) ---
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_TEMPLATE_NAME=aegis_critical_tamper_breach

# --- SMS fallback (Msg91 / Twilio - configure ONE) ---
SMS_PROVIDER=msg91
SMS_API_KEY=
SMS_SENDER_ID=AEGISKID
# Twilio alternative:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Parent contact is NEVER stored here. It is supplied per-device at
# provisioning time and stored only as a delivery handle in the DB.
